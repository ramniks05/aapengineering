<IfModule mod_rewrite.c>
    RewriteEngine On

    # /manage is a real folder — route it through index.php (otherwise Apache returns 403)
    RewriteRule ^manage(/.*)?$ index.php [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(config\.(php|production\.php|example\.php)|database\.sql)$">
    Require all denied
</FilesMatch>
